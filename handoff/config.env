# ---------------------------------------------------------------------------------------------
# The ONLY file to edit. Every script in this folder reads its paths and accounts from here.
# Use:  source config.env   (the run scripts do this for you)
# ---------------------------------------------------------------------------------------------

# this folder (absolute path)
export BUNDLE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Slurm accounts
export ACCOUNT_GPU=rrg-zhijing          # account for GPU jobs
export ACCOUNT_CPU=def-zhijing          # account for CPU jobs

# large storage: models, generated chains, adapters, caches (needs ~100 GB free)
export MODELS_DIR=/scratch/$USER/handoff/models        # holds Qwen3-14B-Base/ and gemma-3-12b-pt-text/
export OUTPUT_DIR=/scratch/$USER/handoff/outputs
export CACHE_DIR=/scratch/$USER/handoff/cache          # vLLM / Triton / HF caches (many small files: keep OFF /home)

# Python environments (see setup/README.md)
export VENV_VLLM=$HOME/venvs/handoff-vllm              # generation + evaluation
export VENV_TRAIN=$HOME/venvs/handoff-train            # LoRA training

# environment modules loaded at the start of each job (leave empty if your cluster has no `module`)
export MODULES_VLLM="python/3.11 cuda arrow"
export MODULES_TRAIN="python/3.11 cuda"

# GPU type in the Slurm request (e.g. h100, a100); jobs assume 80 GB GPUs
export GPU_TYPE=h100
