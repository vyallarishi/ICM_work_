{
  "defaults": {
    "model": "Qwen/Qwen3-8B-Base",
    "dataset": "open-multilang/gsm8k-106",
    "split": "train",
    "dtype": "bfloat16",
    "tensor_parallel_size": 1,
    "gpu_memory_utilization": 0.92,
    "max_model_len": 4096,
    "max_new_tokens": 512,
    "batch_size": 64,
    "max_num_seqs": 512,
    "max_num_batched_tokens": 32768,
    "enable_prefix_caching": true,
    "few_shot_split": "test",
    "tolerance": "0",
    "candidate_source": "retry"
  },
  "regimes": [
    {
      "name": "retry_insufficient_usable",
      "retry_when": "insufficient_usable",
      "min_usable": 4,
      "prompt_template": "few_shot_cot",
      "few_shot_count": 6,
      "temperature": 0.2,
      "top_p": 0.95,
      "n": 8,
      "seed": 1101
    },
    {
      "name": "retry_low_answer_diversity",
      "retry_when": "low_answer_diversity",
      "min_distinct_answers": 2,
      "prompt_template": "few_shot_cot",
      "few_shot_count": 6,
      "temperature": 1.1,
      "top_p": 0.98,
      "n": 8,
      "seed": 1303
    }
  ]
}
